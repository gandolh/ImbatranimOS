{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "env": ["VITE_API_URL", "VITE_BASE"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "test:e2e": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs": {
      "inputs": [
        "docs/**",
        "src/**",
        "static/**",
        "scripts/**",
        "docusaurus.config.ts",
        "sidebars.ts",
        "typedoc.json",
        "../core/src/**",
        "../backend/src/**",
        "../../corpus/**"
      ],
      "outputs": ["dist/**", "static/reference/**"]
    }
  }
}
