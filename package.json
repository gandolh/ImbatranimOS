{
  "name": "imbatranimos",
  "version": "1.52.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/backend",
    "apps/core",
    "apps/add-ons/*",
    "apps/docs",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "docker compose -f infrastructure/docker-compose.yml --profile dev watch",
    "dev:local": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test test:e2e",
    "typecheck": "turbo typecheck",
    "format:check": "turbo format:check",
    "docs": "turbo run docs",
    "install:tooling": "npm install --ignore-scripts",
    "codegraph:init": "codegraph init",
    "codegraph:sync": "codegraph sync",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "turbo": "^2.10.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "node-pty": true,
    "protobufjs": true,
    "sharp": true,
    "unrs-resolver": true,
    "vue-demi": true
  },
  "overrides": {
    "pdfjs-dist": "^6.4.299",
    "@univerjs/core": {
      "nanoid": "^5.1.16"
    },
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  }
}
