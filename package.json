{
  "name": "imbatranimos",
  "version": "1.334.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/backend",
    "apps/core",
    "apps/add-ons/*",
    "apps/docs",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev.mjs",
    "dev:local": "turbo dev",
    "lint": "eslint .",
    "test": "turbo test test:e2e --concurrency=50%",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "turbo run docs",
    "install:tooling": "npm install --ignore-scripts",
    "codegraph:init": "codegraph init",
    "codegraph:sync": "codegraph sync",
    "version:bump": "node scripts/bump-version.mjs",
    "verified:sync": "node scripts/verified-sync.mjs",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "check:fast": "node scripts/check-fast.mjs",
    "check:conventions": "knip && depcruise apps/core/src packages/ui/src apps/add-ons/*/src apps/backend/src && node vendor/house-style/bin/check-base-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "node-pty": true,
    "protobufjs": true,
    "sharp": true,
    "unrs-resolver": true,
    "vue-demi": true
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
