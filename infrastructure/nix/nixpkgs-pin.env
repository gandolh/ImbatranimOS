# The one nixpkgs snapshot Linux apps install from. Nothing else in the repo
# repeats these values: the image build turns the commit into the flake
# registry's `nixpkgs` entry, installs the base profile from it, and bakes the
# snapshot's package index (packages.json.br) for the Linux apps pane.
#
# NIXPKGS_SNAPSHOT is the release snapshot's directory on releases.nixos.org,
# and NIXPKGS_COMMIT the commit it was built from; the build checks that the
# two agree. To move the pin, open https://channels.nixos.org/<release>: it
# redirects to https://releases.nixos.org/nixos/<version>/<snapshot>/. Copy
# that last part into NIXPKGS_SNAPSHOT and the snapshot's git-revision into
# NIXPKGS_COMMIT, change NIXPKGS_RELEASE if the release changes, and rebuild.
NIXPKGS_RELEASE=nixos-26.05
NIXPKGS_SNAPSHOT=nixos-26.05.13446.7dcdd87373d7
NIXPKGS_COMMIT=7dcdd87373d72e7a2173e4db02e20d3d7f495cfd
