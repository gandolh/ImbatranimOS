{
  "name": "@imbatranim/docs-site",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "ImbatranimOS documentation site — narrative rendered from corpus/, reference generated from the TypeScript.",
  "scripts": {
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "diagrams": "node scripts/build-diagrams.mjs",
    "ref:core": "typedoc",
    "ref:backend:gate": "compodoc -p ../backend/tsconfig.json -d static/reference/backend --coverageTest 35",
    "ref:backend": "npm run ref:backend:gate && compodoc -p ../backend/tsconfig.json -d static/reference/backend -n \"ImbatranimOS Backend API\" --hideGenerator --theme material",
    "ref": "npm run ref:core && npm run ref:backend",
    "prestart": "npm run sync-corpus && npm run diagrams",
    "start": "docusaurus start",
    "dev": "npm run start",
    "docs": "npm run sync-corpus && npm run diagrams && npm run ref && docusaurus build --out-dir dist",
    "typecheck": "tsc",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^19.2.14",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
