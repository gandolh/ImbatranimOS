{
  "schemaVersion": 2,
  "id": "games",
  "name": "Games",
  "description": "Minesweeper and Solitaire, the two classic desktop games.",
  "source": {
    "repo": "https://github.com/gandolh/imbatranim-apps",
    "ref": "647580ffdc43852aa42ed3ba7cd1ace1f1822669"
  },
  "type": "static",
  "runtime": "native",
  "sharedKit": 1,
  "build": {
    "install": ["npm", "ci", "--workspace=games"],
    "command": ["npm", "run", "build:os", "--workspace=games"],
    "output": "games/dist/os"
  },
  "apps": [
    {
      "id": "minesweeper",
      "name": "Minesweeper",
      "description": "Flags, chords and best times \u2014 the classic",
      "meta": ["game", "mines", "flags", "classic", "puzzle"],
      "entry": "minesweeper/app.mjs",
      "window": {
        "defaultSize": {
          "w": 340,
          "h": 440
        },
        "minSize": {
          "w": 300,
          "h": 400
        }
      },
      "icon": "bomb",
      "multiInstance": false,
      "capabilities": ["shortcuts"],
      "styles": ["minesweeper/app.css"]
    },
    {
      "id": "solitaire",
      "name": "Solitaire",
      "description": "Klondike \u2014 draw 1 or 3, unlimited undo, auto-finish",
      "meta": ["game", "cards", "klondike", "classic", "patience"],
      "entry": "solitaire/app.mjs",
      "window": {
        "defaultSize": {
          "w": 560,
          "h": 560
        },
        "minSize": {
          "w": 460,
          "h": 460
        }
      },
      "icon": "spade",
      "multiInstance": false,
      "capabilities": ["shortcuts"],
      "styles": ["solitaire/app.css"]
    }
  ],
  "minSystemVersion": 2
}
