  "cards": [
    {
      "dot": "emerald",
      "title": "One container, one port",
      "items": [
        "In prod NestJS serves the built desktop, the REST API and the WebSockets together",
        "The dev target splits into two ports for Vite HMR; prod does not",
        "So 'is it up' is one health check, not a matrix of them"
      ]
    },
    {
      "dot": "cyan",
      "title": "The machinery is real",
      "items": [
        "A real PTY behind /api/pty, not a fake terminal",
        "A real filesystem and a real /proc, so the monitor reads actual numbers",
        "A named home volume, so a rebuild does not wipe what you made"
      ]
    },
    {
      "dot": "rose",
      "title": "Least privilege, structurally",
      "items": [
        "Rootless dockerd under an unprivileged services account",
        "The docker group is root-equivalent, so membership was refused",
        "Container root maps to an unprivileged host subuid"
      ]
    }
  ]
