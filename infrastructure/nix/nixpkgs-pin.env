# The one nixpkgs revision Linux apps install from. Nothing else in the repo
# repeats these two values: the image build turns them into the flake
# registry's `nixpkgs` entry, and the Linux apps pane reads this file to search
# the same release.
#
# To move the pin, take the commit from
#   https://channels.nixos.org/<release>/git-revision
# (the GitHub branch of the same name points at the same commit), change both
# lines if the release changes, and rebuild the image.
NIXPKGS_RELEASE=nixos-26.05
NIXPKGS_COMMIT=9bb52223f4f6a0cc606fd0852d8784f896c137d5
